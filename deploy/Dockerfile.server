# Build first:  ./gradlew :server:installDist
# Context: repository root (see docker-compose.yml).
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 quests
COPY server/build/install/server /app
USER quests
# 8080: outer /ohttp (public, behind the relay) · 9090: health/metrics (internal only)
EXPOSE 8080 9090
ENTRYPOINT ["/app/bin/server"]
