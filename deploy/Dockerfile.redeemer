# Build first:  ./gradlew :redeemer:installDist
# Context: repository root (see docker-compose.yml).
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 redeemer
COPY redeemer/build/install/redeemer /app
USER redeemer
# 8081: outer gateway (behind its own relay) · 9091: health (internal only)
EXPOSE 8081 9091
ENTRYPOINT ["/app/bin/redeemer"]
